-- [BUTTON 2 LOGIC] Loop Auto Send Trade
task.spawn(function()
    while true do
        if isSendOn and event and not isTradePending() then
            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                if targetPlayer ~= LocalPlayer and allowedLookup[targetPlayer.Name] then
                    pcall(function() 
                        event:FireServer("sendTradeRequest", targetPlayer) 
                    end)
                    
                    if isTradePending() then break end
                    task.wait(0.05)
                end
            end
        end
        task.wait(0.3)
    end
end)

-- [BUTTON 3 LOGIC] Loop Auto Give Pet
task.spawn(function()
    while true do
        if isGiveOn and event then
            if not isTradePending() then
                pcall(function()
                    local targetPlayer = getValidTargetPlayer()
                    if targetPlayer then
                        event:FireServer("requestAccepted", targetPlayer)
                    end
                end)
                task.wait(0.2)
            else
                local startTime = os.clock()
                local pets = getPetInstances(PetName, amount)
                local index = 1
                
                while (os.clock() - startTime) < 0.5 do
                    local pet = pets[index]
                    if pet and pet.Parent then
                        pcall(function()
                            event:FireServer("offerItem", pet)
                        end)
                        index = index + 1
                        if index > #pets then break end
                    end
                    task.wait(0.001)
                end
                
                pcall(function()
                    event:FireServer("acceptTrade")
                end)
                
                while isTradePending() do
                    task.wait(0.1)
                end
                
                task.wait(0.3)
            end
        end
        task.wait(0.05)
    end
end)

